# ==============================================================================
# AttendX — Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate_a_64_character_random_hex_string_for_production_sessions

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=attendx
POSTGRES_PASSWORD=attendx_secure_pass_2026
POSTGRES_DB=attendx
DATABASE_URL=postgresql+asyncpg://attendx:attendx_secure_pass_2026@127.0.0.1:5432/attendx

# Redis (Dynamic QR Challenges, Session Storage, Pub/Sub)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Background Worker
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Security & Cookies
SESSION_COOKIE_NAME=attendx_session
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=false # Set to true when serving behind HTTPS
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Dynamic QR Security Policies
QR_DEFAULT_ROTATION_SECONDS=10
QR_CHALLENGE_TTL_SECONDS=15
QR_GRACE_PERIOD_SECONDS=5

# Attendance Academic Policies
MINIMUM_ATTENDANCE_PERCENTAGE=75.0
LATE_WEIGHT=0.5
ALLOWED_LATE_MINUTES=15

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
